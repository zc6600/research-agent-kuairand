{
  "name": "research-agent-slides",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:main": "node scripts/prepare-main-deck.mjs",
    "check:paths": "node scripts/check-exports.mjs",
    "dev": "npm run prepare:main && slidev .generated-slides.md --port 3030",
    "build": "npm run prepare:main && slidev build .generated-slides.md --base ./",
    "postbuild": "rm -f dist/_redirects",
    "export": "npm run prepare:main && slidev export .generated-slides.md --wait 3500 --output exports/current/SciOdyssey-main.pdf",
    "voyage:dev": "slidev slides-voyage.md --port 3032",
    "voyage:export": "slidev export slides-voyage.md --wait 3500 --output exports/current/SciOdyssey-voyage.pdf",
    "3d:dev": "slidev slides-3d.md --port 3033",
    "3d:export": "slidev export slides-3d.md --wait 4000 --output exports/current/SciOdyssey-3d.pdf",
    "poster:dev": "slidev posters/slidev/poster.md --port 3031",
    "poster:export": "slidev export posters/slidev/poster.md --wait 1800 --output exports/current/SciOdyssey-poster.pdf && node scripts/poster-print-size.mjs exports/current/SciOdyssey-poster.pdf",
    "poster:editorial": "slidev export posters/slidev/poster-editorial.md --wait 1800 --output exports/current/SciOdyssey-poster-editorial.pdf && node scripts/poster-print-size.mjs exports/current/SciOdyssey-poster-editorial.pdf",
    "poster:evidence": "slidev export posters/slidev/poster-evidence.md --wait 1800 --output exports/current/SciOdyssey-poster-evidence.pdf && node scripts/poster-print-size.mjs exports/current/SciOdyssey-poster-evidence.pdf",
    "poster:type": "slidev export posters/slidev/poster-type.md --wait 1800 --output exports/current/SciOdyssey-poster-type.pdf && node scripts/poster-print-size.mjs exports/current/SciOdyssey-poster-type.pdf",
    "poster:html:voyage": "node posters/html/voyage/export.mjs",
    "poster:html:main-deck": "node posters/html/main-deck-update/export.mjs",
    "poster:variants": "npm run poster:editorial && npm run poster:evidence && npm run poster:type",
    "poster:png": "npm run poster:export && gs -q -dSAFER -dBATCH -dNOPAUSE -dTextAlphaBits=4 -dGraphicsAlphaBits=4 -sDEVICE=png16m -r96 -sOutputFile=exports/current/SciOdyssey-poster.png exports/current/SciOdyssey-poster.pdf"
  },
  "devDependencies": {
    "@slidev/cli": "^52.19.1",
    "@slidev/theme-default": "^0.25.0",
    "playwright-chromium": "^1.55.0"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
